Guile's scm_c_define_module runs the module body through a C callback that it casts to
void(*)(void*). WebAssembly checks every indirect call's signature at run time, so that cast
traps before the module is ever defined, and nothing that uses (define-module ...) loads --
which is all of LilyPond's Scheme. Pass the callback and its data through a small struct with
the signature Guile actually declares, so no cast is needed.
--- a/libguile/modules.c
+++ b/libguile/modules.c
@@ -196,6 +196,20 @@
                      k_ensure, SCM_BOOL_F);
 }
 
+struct module_init_data
+{
+  void (*init) (void *);
+  void *data;
+};
+
+static SCM
+module_init_trampoline (void *data)
+{
+  struct module_init_data *closure = data;
+  closure->init (closure->data);
+  return SCM_UNSPECIFIED;
+}
+
 SCM
 scm_c_define_module (const char *name,
 		     void (*init)(void *), void *data)
@@ -203,7 +217,10 @@
   SCM module = scm_call_1 (SCM_VARIABLE_REF (define_module_star_var),
 			   convert_module_name (name));
   if (init)
-    scm_c_call_with_current_module (module, (SCM (*)(void*))init, data);
+    {
+      struct module_init_data closure = { init, data };
+      scm_c_call_with_current_module (module, module_init_trampoline, &closure);
+    }
   return module;
 }
 
