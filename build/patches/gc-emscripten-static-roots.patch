Boehm GC on Emscripten defines an empty data segment, so nothing static is a root. Guile keeps
live SCM values in static variables (symbols, module handles, LilyPond's cached ly:symbols), so
scan the whole data region between the linker's __global_base and __data_end symbols.
--- a/include/private/gcconfig.h
+++ b/include/private/gcconfig.h
@@ -1477,8 +1477,10 @@
 #   endif
 #   ifdef EMSCRIPTEN
 #     define OS_TYPE "EMSCRIPTEN"
-#     define DATASTART (ptr_t)ALIGNMENT
-#     define DATAEND (ptr_t)ALIGNMENT
+      extern char __global_base[];
+      extern char __data_end[];
+#     define DATASTART ((ptr_t)__global_base)
+#     define DATAEND ((ptr_t)__data_end)
       /* Emscripten does emulate mmap and munmap, but those should  */
       /* not be used in the collector, since WebAssembly lacks the  */
       /* native support of memory mapping.  Use sbrk() instead.     */
